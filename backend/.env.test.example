# Ambiente dos testes (copie para .env.test, que fica fora do git). Aponta para o
# docker-compose.test.yml. Os testes RECUSAM rodar se o banco não for local e não terminar em _test.
DATABASE_URL="postgresql://gametracker:gt_test_dev@localhost:5434/gametracker_test"
REDIS_URL="redis://localhost:6381"
JWT_ACCESS_SECRET="segredo-so-para-testes"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
# `npm run dev:test` sobe a API aqui, para o app (mobile/) rodar os testes de integração contra ela.
PORT=3100
PUBLIC_API_URL="http://localhost:3100"
# Os testes criam muitos usuários; o limite padrão (20 por 15 min por IP) atrapalharia.
AUTH_RATE_LIMIT_MAX=100000
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""
