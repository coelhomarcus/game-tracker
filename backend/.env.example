# Valores abaixo são para desenvolvimento local (docker-compose.dev.yml na raiz).
# Em produção (Dokploy), essas URLs apontam pro hostname interno dos serviços
# Postgres/Redis já existentes lá — configuradas como env vars no dashboard do Dokploy,
# não neste arquivo.
DATABASE_URL="postgresql://gametracker:gametracker_dev_password@localhost:5432/gametracker?schema=public"

PORT=3000

JWT_ACCESS_SECRET="troque-por-um-segredo-forte"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

REDIS_URL="redis://localhost:6379"

# URL pública onde esta API responde — usada pra montar a URL do proxy de capas
# (o próprio backend precisa saber como se referenciar). Em dev local sem domínio,
# pode deixar sem definir: cai no fallback http://localhost:PORT.
PUBLIC_API_URL="https://api.seudominio.com"

# Só para ambientes de teste isolados: sobe o limite de login/cadastro (padrão: 20 por 15 min por IP).
# AUTH_RATE_LIMIT_MAX=1000
# Só para ambientes de teste isolados: limite de envios de imagem de post por usuário (padrão: 30 por 10 min).
# POST_IMAGE_RATE_LIMIT_MAX=1000

# Origens web autorizadas a ler a API (CORS), separadas por vírgula. Sem esta variável qualquer
# origem é aceita. Em produção, defina com o endereço do app web. Apps nativos não são afetados.
# CORS_ORIGINS="https://app.seudominio.com"
